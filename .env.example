# ========================================
# WHATSAPP API CONFIGURATION
# ========================================
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# ========================================
# OPENAI API CONFIGURATION
# ========================================
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# SUPABASE DATABASE CONFIGURATION
# ========================================
INVENTORY_SUPABASE_URL=https://your-project.supabase.co
INVENTORY_SUPABASE_KEY=your_supabase_anon_key_here

# ========================================
# PINECONE VECTOR DATABASE
# ========================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name

# ========================================
# ONELINK PAYMENT PROCESSING
# ========================================
ONELINK_BASE_URL=https://your-onelink-base-url.com
ONELINK_MERCHANT_ALIAS=your_merchant_alias
ONELINK_MERCHANT_SECRET=your_merchant_secret
ONELINK_MERCHANT_TOKEN=your_merchant_token

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
FLASK_ENV=production
SKIP_EMBEDDINGS_ON_STARTUP=false
FORCE_REGENERATE_EMBEDDINGS=false

# ========================================
# GROQ API (for audio transcription)
# ========================================
GROQ_API_KEY=your_groq_api_key_here